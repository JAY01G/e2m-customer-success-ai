# ==============================================================================
# ENVIRONMENT CONFIGURATION - AI-POWERED CUSTOMER SUCCESS PLATFORM
# ==============================================================================

# Application
APP_NAME="AI-Powered Customer Success Platform"
APP_ENV=development
DEBUG=true

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=customer_success_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/customer_success_db

# Redis Caching
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=60
CACHE_ENABLED=true

# Security & JWT
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars-long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# AI Provider Configuration
# Supported providers: "openai", "anthropic", or "mock" (offline deterministic heuristic)
AI_PROVIDER=mock
AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=15
AI_TEMPERATURE=0.2

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
