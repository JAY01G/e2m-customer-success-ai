# ==============================================================================
# Environment & Secret Files (never commit real secrets)
# ==============================================================================
.env
.env.*
*.env
**/.env
**/.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!**/.env.example
*.pem
*.key
*.cert

# ==============================================================================
# Python & Backend
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage (Python)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Databases & Local Storage
*.sqlite
*.sqlite3
*.db
*.db-journal

# ==============================================================================
# Node, Next.js & Frontend
# ==============================================================================
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
.eslintcache
.parcel-cache/
.turbo/
.vercel/

# Testing & Coverage (JS/TS)
coverage/
.nyc_output/

