# ==============================================================================
# BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Application Settings
APP_NAME="AI-Powered Customer Success Platform"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=customer_success_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/customer_success_db

# Redis Caching
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=60
CACHE_ENABLED=true

# Security & JWT Token Signatures
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars-long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# AI Provider Configuration
# Supported providers: "mock" (offline heuristic), "openai", or "anthropic"
AI_PROVIDER=mock
AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=15
AI_TEMPERATURE=0.2
